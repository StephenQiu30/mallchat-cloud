# Normalize line endings for common files
* text=auto

# Source code
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ttf binary
